# ===== 运行期产物 =====
# 服务端运行日志
Server/logs/
Server/*.log
*.log

# ===== 编译产物（若在 Server-Source 内执行 dotnet build/publish）=====
bin/
obj/
publish/
Server-Source/bin/
Server-Source/obj/

# ===== 临时/备份 =====
*.bak
*.crash_*
*.tmp
Thumbs.db
.DS_Store

# ===== 本仓库应保留的内容（勿加 ignore）=====
# Server/Data/responses/  -> 官方回放数据，运行必需
# Client-Plugin/          -> BepInEx + dotnet 运行时 + 插件，运行必需
# cert.* / rsa_*.txt      -> 自签证书与 RSA 密钥，运行必需
